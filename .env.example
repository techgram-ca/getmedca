# ---- Supabase (project MUST be in ca-central-1 / Montreal) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Mapbox (single token: Geocoding, Search Box/Autofill, Matrix) ----
NEXT_PUBLIC_MAPBOX_TOKEN=pk.
MAPBOX_SERVER_TOKEN=pk.

# ---- Cloudflare Turnstile ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Twilio (SMS / OTP) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1

# ---- Resend (email) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=GetMed <no-reply@getmed.ca>

# ---- Inngest (durable workflows: 30-min pharmacy SLA timer) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Sentry ----
NEXT_PUBLIC_SENTRY_DSN=

# ---- App URLs ----
NEXT_PUBLIC_PATIENT_URL=http://localhost:3000
NEXT_PUBLIC_PHARMACY_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_DRIVER_URL=http://localhost:3003

# ---- Admin escalation contact (single admin) ----
ADMIN_NOTIFICATION_EMAIL=admin@getmed.ca
ADMIN_NOTIFICATION_PHONE=+1

# ---- Secret used to HMAC OTP codes at rest ----
OTP_HASH_SECRET=change-me
